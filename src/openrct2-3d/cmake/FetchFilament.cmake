set(filament_version "1.80.0")
if(CMAKE_HOST_WIN32)
    set(CMAKE_EXECUTABLE_SUFFIX ".exe")
endif()
if(NOT DEFINED FILAMENT_SDK OR FILAMENT_SDK STREQUAL "")
    get_filename_component(FILAMENT_SDK "${CMAKE_CURRENT_LIST_DIR}/../../../lib/filament-v${filament_version}" ABSOLUTE)
endif()
if(EXISTS "${FILAMENT_SDK}/include/filament/Engine.h" AND EXISTS "${FILAMENT_SDK}/bin/matc${CMAKE_EXECUTABLE_SUFFIX}")
    return()
endif()
if(NOT DEFINED FILAMENT_PLATFORM)
    if(CMAKE_HOST_WIN32)
        set(FILAMENT_PLATFORM windows)
    elseif(CMAKE_HOST_APPLE)
        set(FILAMENT_PLATFORM mac)
    elseif(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
        set(FILAMENT_PLATFORM arm-linux)
    else()
        set(FILAMENT_PLATFORM linux)
    endif()
endif()
set(hash_windows d464617fd70e756d75a86893388d4438f0023826ff989f4de03ce1bd9bc5798f)
set(hash_linux 15e5ce6024f12a551d0348b025453705cfdb6e4e91c06f5d7ae0c7033f21c2f6)
set(hash_arm-linux 8ef6951145e1237935eba8441c8a186a21567113e5f1569062416d66b4da86db)
set(hash_mac b514ec6dc8d6026e70f6e0dc9673b1c5748060a4be5137aea8502a46d740fb6b)
if(NOT DEFINED hash_${FILAMENT_PLATFORM})
    message(FATAL_ERROR "Unsupported Filament SDK platform: ${FILAMENT_PLATFORM}. Supply a matching FILAMENT_SDK.")
endif()
file(MAKE_DIRECTORY "${FILAMENT_SDK}")
set(archive "${FILAMENT_SDK}/sdk.tgz")
message(STATUS "Downloading Filament ${filament_version} (${FILAMENT_PLATFORM})")
file(DOWNLOAD
    "https://github.com/google/filament/releases/download/v${filament_version}/filament-v${filament_version}-${FILAMENT_PLATFORM}.tgz"
    "${archive}" EXPECTED_HASH "SHA256=${hash_${FILAMENT_PLATFORM}}" TLS_VERIFY ON SHOW_PROGRESS)
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${FILAMENT_SDK}")
if(EXISTS "${FILAMENT_SDK}/filament/include/filament/Engine.h")
    file(COPY "${FILAMENT_SDK}/filament/" DESTINATION "${FILAMENT_SDK}")
    file(REMOVE_RECURSE "${FILAMENT_SDK}/filament")
endif()
if(NOT EXISTS "${FILAMENT_SDK}/include/filament/Engine.h")
    message(FATAL_ERROR "Filament SDK archive has an unexpected layout: ${FILAMENT_SDK}")
endif()
