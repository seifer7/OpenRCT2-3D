# Inspect generated shaders without creating a graphics device or running the game.
if(NOT DEFINED FILAMENT_SDK OR NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "FILAMENT_SDK and OUTPUT_DIR are required")
endif()
get_filename_component(FILAMENT_SDK "${FILAMENT_SDK}" ABSOLUTE)
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/CompileMaterials.cmake")
set(matinfo "${FILAMENT_SDK}/bin/matinfo${tool_suffix}")
if(NOT EXISTS "${matinfo}")
    message(FATAL_ERROR "Material UV regression checks require the matching SDK's matinfo tool")
endif()
foreach(name mesh_opaque mesh_masked mesh_blend sprite terrain water)
    execute_process(COMMAND "${matinfo}" -g 0 "${OUTPUT_DIR}/${name}.filamat"
        OUTPUT_VARIABLE shader RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Unable to inspect compiled material: ${name}")
    endif()
    # Uploaded pixels and CPU UVs already share a top-row-first convention.
    if(NOT shader MATCHES "material\\.uv0[ \t]*=[ \t]*mesh_uv0;")
        message(FATAL_ERROR "${name} must preserve UV0 without Filament's automatic V flip")
    endif()
    # Terrain UV1 is world tile XY, not a normalized texture coordinate.
    if(name STREQUAL "terrain" OR name STREQUAL "water")
        if(NOT shader MATCHES "material\\.uv1[ \t]*=[ \t]*mesh_uv1;")
            message(FATAL_ERROR "${name} must preserve world tile coordinates in UV1")
        endif()
    endif()
    message(STATUS "${name}: compiled UV coordinates preserved")
endforeach()
