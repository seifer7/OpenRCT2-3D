<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Static library for the Filament 3D viewer. Filament.targets compiles embedded materials.
    bx remains camera math; bimg supplies only stb_image.h.
  -->
  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)'==''">..\..\</SolutionDir>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|arm64">
      <Configuration>Debug</Configuration>
      <Platform>arm64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="ReleaseLTCG|arm64">
      <Configuration>ReleaseLTCG</Configuration>
      <Platform>arm64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="ReleaseLTCG|Win32">
      <Configuration>ReleaseLTCG</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="ReleaseLTCG|x64">
      <Configuration>ReleaseLTCG</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|arm64">
      <Configuration>Release</Configuration>
      <Platform>arm64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{3D4E8A21-6B17-4F0C-9C55-A1E2D83F70B4}</ProjectGuid>
    <RootNamespace>openrct2-3d</RootNamespace>
    <ProjectName>openrct2-3d</ProjectName>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="..\..\openrct2.common.props" />
  <Import Project="Filament.props" />
  <!--
    The rest of this solution finds headers through IncludePath. MSBuildThisFileDirectory is the
    directory of this vcxproj, with a trailing slash, so these paths stay absolute.
  -->
  <PropertyGroup>
    <View3DIncludes>$(MSBuildThisFileDirectory)src;$(IntDir)filament-materials;$(MSBuildThisFileDirectory)third_party\cgltf;$(MSBuildThisFileDirectory)third_party\bimg\3rdparty\stb;$(MSBuildThisFileDirectory)third_party\bx\include;$(MSBuildThisFileDirectory)third_party\bx\3rdparty;$(MSBuildThisFileDirectory)third_party\bx\include\compat\msvc</View3DIncludes>
    <IncludePath>$(View3DIncludes);$(IncludePath)</IncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalOptions>/Zc:__cplusplus /Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(View3DIncludes);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">BX_CONFIG_DEBUG=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'!='Debug'">BX_CONFIG_DEBUG=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Lib>
      <TargetMachine Condition="'$(Platform)'=='Win32'">MachineX86</TargetMachine>
      <TargetMachine Condition="'$(Platform)'=='x64'">MachineX64</TargetMachine>
      <TargetMachine Condition="'$(Platform)'=='arm64'">MachineARM64</TargetMachine>
    </Lib>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="src\FilamentRenderer.hpp" />
    <ClInclude Include="src\GlbMesh.hpp" />
    <ClInclude Include="src\MeshDraw.hpp" />
    <ClInclude Include="src\GpuBudget.hpp" />
    <ClInclude Include="src\ModelCache.hpp" />
    <ClInclude Include="src\ModelLoadQueue.hpp" />
    <ClInclude Include="src\ParkView.hpp" />
    <ClInclude Include="src\SceneryChunk.hpp" />
    <ClInclude Include="src\SceneryScale.hpp" />
    <ClInclude Include="src\SceneryDraw.hpp" />
    <ClInclude Include="src\SpriteQuad.hpp" />
    <ClInclude Include="src\ViewerScale.hpp" />
    <ClInclude Include="src\PaletteComposite.hpp" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\FilamentRenderer.cpp" />
    <ClCompile Include="src\GlbMesh.cpp" />
    <ClCompile Include="src\GpuBudget.cpp" />
    <ClCompile Include="src\MeshDraw.cpp" />
    <ClCompile Include="src\ModelCache.cpp" />
    <ClCompile Include="src\ModelLoadQueue.cpp" />
    <ClCompile Include="src\SceneryChunk.cpp" />
    <ClCompile Include="src\ParkView.cpp" />
    <ClCompile Include="src\SceneryDraw.cpp" />
    <ClCompile Include="src\FilamentView.cpp" />
    <ClCompile Include="third_party\cgltf\cgltf.cpp">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
    </ClCompile>
    <ClCompile Include="third_party\stb_image_impl.cpp">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
    </ClCompile>
    <ClCompile Include="third_party\bx\src\amalgamated.cpp">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <ObjectFileName>$(IntDir)bx_amalgamated.obj</ObjectFileName>
      <ExceptionHandling>false</ExceptionHandling>
      <PreprocessorDefinitions>_HAS_EXCEPTIONS=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile Include="$(IntDir)filament-materials\view3d_materials.c">
      <CompileAs>CompileAsC</CompileAs>
      <LanguageStandard>
      </LanguageStandard>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\openrct2-deps\openrct2-deps.vcxproj">
      <Project>{c453da76-44b3-4ac8-aaa2-2b64a76993a5}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="InitView3DSubmodules" Condition="!Exists('$(MSBuildThisFileDirectory)third_party\bx\include\bx\bx.h') Or !Exists('$(MSBuildThisFileDirectory)third_party\bimg\3rdparty\stb\stb_image.h')">
    <PropertyGroup>
      <View3DGit Condition="'$(View3DGit)' == '' and Exists('$(ProgramW6432)\Git\cmd\git.exe')">$(ProgramW6432)\Git\cmd\git.exe</View3DGit>
      <View3DGit Condition="'$(View3DGit)' == '' and Exists('$(ProgramFiles)\Git\cmd\git.exe')">$(ProgramFiles)\Git\cmd\git.exe</View3DGit>
      <View3DGit Condition="'$(View3DGit)' == '' and Exists('$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\TeamFoundation\Team Explorer\Git\cmd\git.exe')">$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\TeamFoundation\Team Explorer\Git\cmd\git.exe</View3DGit>
      <View3DGit Condition="'$(View3DGit)' == ''">git</View3DGit>
    </PropertyGroup>
    <Message Importance="high" Text="Fetching bx math and stb image utility submodules." />
    <Exec Command="&quot;$(View3DGit)&quot; -C &quot;$(MSBuildThisFileDirectory)..\..&quot; submodule update --init -- src/openrct2-3d/third_party/bx src/openrct2-3d/third_party/bimg" />
  </Target>
  <Target Name="CheckView3DSources" BeforeTargets="PrepareForBuild" DependsOnTargets="InitView3DSubmodules">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)third_party\bx\include\bx\bx.h')" Text="Missing third_party\bx\include\bx\bx.h. Run git submodule update --init --recursive." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)third_party\bimg\3rdparty\stb\stb_image.h')" Text="Missing third_party\bimg\3rdparty\stb\stb_image.h. Run git submodule update --init --recursive." />
  </Target>
  <ItemGroup>
    <None Include="cmake\TestMaterialUvs.cmake" />
    <None Include="materials\mesh.mat" />
    <None Include="materials\sprite.mat" />
    <None Include="materials\terrain.mat" />
    <None Include="Filament.props" />
    <None Include="Filament.targets" />
    <None Include="cmake\CompileMaterials.cmake" />
    <None Include="cmake\FetchFilament.cmake" />
  </ItemGroup>
  <Import Project="Filament.targets" />
</Project>