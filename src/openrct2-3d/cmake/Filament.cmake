if(CMAKE_SIZEOF_VOID_P LESS 8)
    message(FATAL_ERROR "The Filament desktop viewer requires a 64-bit build. Select x64 or a matching ARM64 SDK.")
endif()
if(MINGW)
    message(FATAL_ERROR "The pinned Windows Filament SDK uses the MSVC ABI. Build this branch with MSVC x64.")
endif()
set(FILAMENT_SDK "$ENV{FILAMENT_SDK}" CACHE PATH "Filament 1.80.0 SDK (including matc and resgen)")
if(NOT FILAMENT_SDK)
    set(FILAMENT_SDK "${CMAKE_CURRENT_LIST_DIR}/../../../lib/filament-v1.80.0" CACHE PATH "Filament SDK" FORCE)
endif()
get_filename_component(FILAMENT_SDK "${FILAMENT_SDK}" ABSOLUTE)
if(NOT EXISTS "${FILAMENT_SDK}/include/filament/Engine.h")
    if(CMAKE_CROSSCOMPILING OR CMAKE_SIZEOF_VOID_P LESS 8)
        message(FATAL_ERROR "Supply a Filament 1.80.0 SDK matching the target architecture with -DFILAMENT_SDK=...")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/FetchFilament.cmake")
endif()

if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    set(filament_arch aarch64)
else()
    set(filament_arch x86_64)
endif()
set(FILAMENT_LIBRARY_DIR "" CACHE PATH "Override the Filament SDK library directory")
if(NOT FILAMENT_LIBRARY_DIR)
    if(MSVC)
        set(filament_crt md)
        if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "DLL")
            set(filament_crt mt)
        endif()
        set(FILAMENT_LIBRARY_DIR "${FILAMENT_SDK}/lib/${filament_arch}/${filament_crt}")
    elseif(APPLE AND EXISTS "${FILAMENT_SDK}/lib/universal")
        set(FILAMENT_LIBRARY_DIR "${FILAMENT_SDK}/lib/universal")
    elseif(APPLE AND EXISTS "${FILAMENT_SDK}/lib/arm64" AND filament_arch STREQUAL "aarch64")
        set(FILAMENT_LIBRARY_DIR "${FILAMENT_SDK}/lib/arm64")
    else()
        set(FILAMENT_LIBRARY_DIR "${FILAMENT_SDK}/lib/${filament_arch}")
    endif()
endif()

add_library(openrct2-filament-sdk INTERFACE)
add_library(OpenRCT2::FilamentSdk ALIAS openrct2-filament-sdk)
target_include_directories(openrct2-filament-sdk SYSTEM INTERFACE "${FILAMENT_SDK}/include")
foreach(component filament backend filaflat filabridge bluegl bluevk smol-v utils zstd)
    find_library(FILAMENT_${component}_LIBRARY NAMES ${component} PATHS "${FILAMENT_LIBRARY_DIR}" NO_DEFAULT_PATH REQUIRED)
    add_library(openrct2-filament-${component} STATIC IMPORTED)
    set_target_properties(openrct2-filament-${component} PROPERTIES IMPORTED_LOCATION "${FILAMENT_${component}_LIBRARY}")
    if(MSVC AND EXISTS "${FILAMENT_LIBRARY_DIR}d/${component}.lib")
        set_target_properties(openrct2-filament-${component} PROPERTIES
            IMPORTED_LOCATION_DEBUG "${FILAMENT_LIBRARY_DIR}d/${component}.lib")
    endif()
    target_link_libraries(openrct2-filament-sdk INTERFACE openrct2-filament-${component})
endforeach()
find_library(FILAMENT_ABSEIL_LIBRARY NAMES abseil PATHS "${FILAMENT_LIBRARY_DIR}" NO_DEFAULT_PATH)
if(FILAMENT_ABSEIL_LIBRARY)
    add_library(openrct2-filament-abseil STATIC IMPORTED)
    set_target_properties(openrct2-filament-abseil PROPERTIES IMPORTED_LOCATION "${FILAMENT_ABSEIL_LIBRARY}")
    if(MSVC AND EXISTS "${FILAMENT_LIBRARY_DIR}d/abseil.lib")
        set_target_properties(openrct2-filament-abseil PROPERTIES IMPORTED_LOCATION_DEBUG "${FILAMENT_LIBRARY_DIR}d/abseil.lib")
    endif()
    target_link_libraries(openrct2-filament-sdk INTERFACE openrct2-filament-abseil)
endif()
find_package(Threads REQUIRED)
target_link_libraries(openrct2-filament-sdk INTERFACE Threads::Threads ${CMAKE_DL_LIBS})
if(WIN32)
    target_link_libraries(openrct2-filament-sdk INTERFACE opengl32 gdi32 user32 shlwapi)
elseif(APPLE)
    target_link_libraries(openrct2-filament-sdk INTERFACE
        "-framework Cocoa" "-framework QuartzCore" "-framework Metal" "-framework CoreVideo" "-framework OpenGL")
else()
    find_package(OpenGL REQUIRED COMPONENTS OpenGL EGL)
    target_link_libraries(openrct2-filament-sdk INTERFACE OpenGL::OpenGL OpenGL::EGL)
endif()

set(filament_generated "${CMAKE_CURRENT_BINARY_DIR}/filament-materials")
add_custom_command(
    OUTPUT "${filament_generated}/view3d_materials.c" "${filament_generated}/view3d_materials.h"
    COMMAND "${CMAKE_COMMAND}" "-DFILAMENT_SDK=${FILAMENT_SDK}" "-DOUTPUT_DIR=${filament_generated}"
        -P "${CMAKE_CURRENT_LIST_DIR}/CompileMaterials.cmake"
    DEPENDS "${CMAKE_CURRENT_LIST_DIR}/CompileMaterials.cmake"
        "${CMAKE_CURRENT_LIST_DIR}/../materials/mesh.mat"
        "${CMAKE_CURRENT_LIST_DIR}/../materials/sprite.mat"
        "${CMAKE_CURRENT_LIST_DIR}/../materials/terrain.mat"
        "${FILAMENT_SDK}/bin/matc${CMAKE_EXECUTABLE_SUFFIX}"
        "${FILAMENT_SDK}/bin/resgen${CMAKE_EXECUTABLE_SUFFIX}"
    VERBATIM)
add_library(openrct2-filament STATIC "${CMAKE_CURRENT_LIST_DIR}/../src/FilamentRenderer.cpp"
    "${filament_generated}/view3d_materials.c")
target_include_directories(openrct2-filament PRIVATE "${filament_generated}")
target_link_libraries(openrct2-filament PUBLIC OpenRCT2::FilamentSdk)
target_compile_features(openrct2-filament PUBLIC cxx_std_20)
install(FILES "${FILAMENT_SDK}/LICENSE" DESTINATION "${CMAKE_INSTALL_DATADIR}/openrct2/licenses" RENAME filament-LICENSE.txt)
